def cal_average(marks):
    return sum(marks) / len(marks)
def agn_grade(avg):
    if avg >= 90:
        return "A+"
    elif avg >= 80:
        return "A"
    elif avg >= 70:
        return "B"
    elif avg >= 60:
        return "C"
    elif avg >= 50:
        return "D"
    else:
        return "F"
n = int(input("Enter no.of subjects: "))
marks = []
for i in range(n):
    m = float(input(f"Enter marks{i+1}: "))
    if m< 0 or m> 100:
        print("Invalid marks")
        exit()
    marks.append(m)
avg = cal_average(marks)
grade = agn_grade(avg)
print("Student Result")
print("Total Marks:", sum(marks))
print("Average:", avg)
print("Grade:", grade)

